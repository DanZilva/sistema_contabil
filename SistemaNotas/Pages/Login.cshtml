@page
@model LoginModel

<h1>🔐 Login</h1>

<form method="post">
    <input type="text" name="Username" placeholder="Usuário" />
    <input type="password" name="Senha" placeholder="Senha" />
    <button type="submit">Entrar</button>
</form>

@if (Model.MensagemErro != null)
{
    <p style="color:red">@Model.MensagemErro</p>
}