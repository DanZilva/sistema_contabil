@page
@model SistemaNotas.Pages.Notas.CreateModel

<h1>🧾 Cadastrar Nota Fiscal</h1>

<div class="card">

<form method="post" enctype="multipart/form-data">

    <div class="form-box">

        <div>
            <label>Número da NF</label>
            <input asp-for="NovaNota.Numero" />
        </div>

        <div>
            <label>Fornecedor</label>
            <input asp-for="NovaNota.Fornecedor" />
        </div>

        <div>
            <label>Valor</label>
            <input asp-for="NovaNota.Valor" />
        </div>

        <div>
            <label>Data de Emissão</label>
            <input asp-for="NovaNota.DataEmissao" type="date" />
        </div>

        <div>
            <label>Data de Vencimento</label>
            <input asp-for="NovaNota.DataVencimento" type="date" />
        </div>

        <div>
            <label>Empresa</label>
            <select asp-for="NovaNota.Empresa" required>
                <option value="">Selecione</option>
                <option value="DER">DER</option>
                <option value="TRANSBETIM">TRANSBETIM</option>
            </select>
        </div>

        <div>
            <label>Arquivo (PDF)</label>
            <input type="file" asp-for="Arquivo" />
        </div>

        <div>
            <label>Setor</label>
            <select name="NovaNota.Setor">
                <option value="">Selecione</option>
                <option value="TI">TI</option>
                <option value="Financeiro">Financeiro</option>
                <option value="Operacional">Operacional</option>
            </select>
        </div>

    </div>

    <button type="submit">Cadastrar</button>

</form>

</div>