@page
@model ContabilModel
@using SistemaNotas.Models

<h1 class="titulo">🧾 Painel Contábil</h1>


<div class="card">

    <table class="tabela">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nota</th>
                <th>Valor</th>
                <th>Status</th>
                <th>Empresa</th>
                <th>Ações</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var nota in Model.Notas)
            {
                <tr>
                    <td>@nota.Id</td>

                    <!-- 📄 Nota -->
                    <td>@nota.Numero - @nota.Fornecedor</td>

                    <td>R$ @nota.Valor</td>

                    <!-- 🎯 Status -->
                    <td>
                        <span class="status @nota.Status">
                            @nota.Status
                        </span>
                    </td>

                    <td>@nota.Empresa</td>

                    <!-- AÇÕES -->
<td class="acoes">

    <!-- ✏️ Editar -->
    <a href="/Notas/Edit?id=@nota.Id" class="btn-editar">
        ✏️ Editar
    </a>

    <!--  PDF -->
    @if (!string.IsNullOrEmpty(nota.CaminhoArquivo))
    {
        <a href="@nota.CaminhoArquivo" target="_blank">
            📄 Ver
        </a>

        <a href="@nota.CaminhoArquivo" download>
            ⬇️ Baixar
        </a>
    }

    <!--  Classificar -->
    @if (nota.Status == StatusNota.Recebida)
    {
        <form method="post" class="inline-form">
            <input type="hidden" name="id" value="@nota.Id" />
            <input type="text" name="setor" placeholder="Setor" />
            <button asp-page-handler="Classificar">
                Classificar
            </button>
        </form>
    }

    <!-- 🗑️ Excluir -->
    <form method="post" class="inline-form"
          onsubmit="return confirm('Tem certeza que deseja excluir esta nota?');">

        <input type="hidden" name="id" value="@nota.Id" />

        <button asp-page-handler="Excluir" class="btn-delete">
            🗑️ Excluir
        </button>
    </form>

</td>
                </tr>
            }
        </tbody>
    </table>

</div>